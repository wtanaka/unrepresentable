struct Id(u32);
#[derive(Default)]
struct One;
struct Two;
impl std::fmt::Display for Two {
    fn fmt(&self, out: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        Ok(())
    }
}
fn copy(id: &Id) {
    let again = id.clone();
    drop(again);
}
impl Clone for Id {
    fn clone(&self) -> Self {
        Self(self.0)
    }
}
