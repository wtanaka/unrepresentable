fn make() -> Kind {
    Kind::A
}
enum Kind {
    A,
}
enum Answer {
    No,
    Yes,
}
#[test]
fn asserts() {
    let value = make();
    assert!(matches_a(&value) == Answer::Yes, "kind");
}
#[test]
fn asserts_eq() {
    assert_eq!(1, 1, "same");
}
fn matches_a(kind: &Kind) -> Answer {
    match kind {
        Kind::A => Answer::Yes,
    }
}
fn main() {}
